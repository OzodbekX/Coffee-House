# .env.example

# Environment variables for Firebase configuration.
# Replace the placeholder values with your actual Firebase project credentials.

# The API key for your Firebase project
VITE_FIREBASE_API_KEY="YOUR_API_KEY_HERE"

# The auth domain for your Firebase project
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN_HERE"

# The project ID for your Firebase project
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID_HERE"

# The storage bucket URL for your Firebase project
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET_HERE"

# The messaging sender ID for your Firebase project
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID_HERE"

# The App ID for your Firebase web application
VITE_FIREBASE_APP_ID="YOUR_APP_ID_HERE"

# The Measurement ID for Google Analytics (optional)
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID_HERE"